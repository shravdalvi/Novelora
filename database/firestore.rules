rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper functions ──────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'shravanidalvi70@gmail.com' ||
          request.auth.token.email.lower() == 'shravanidalvi2606@gmail.com' ||
          request.auth.token.email.lower().matches('.*shravani.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'author'))
      );
    }

    function isAuthor() {
      return isAdmin();
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function validEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }
    
    // ── Users ─────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read and update ONLY their own profile
      // They cannot change the 'role' field
      allow read: if isOwner(uid) || isAuthor();
      allow create: if (isOwner(uid) && request.resource.data.role == 'reader') || isAuthor();
      allow update: if isOwner(uid) 
        && !('role' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAuthor();
      
      // Bookmarks - user reads/writes their own only
      match /bookmarks/{bookId} {
        allow read, write: if isOwner(uid);
      }
      
      // Reading progress - user reads/writes their own only
      match /progress/{bookId} {
        allow read, write: if isOwner(uid);
      }
      
      // Likes - user reads/writes their own only
      match /likes/{chapterId} {
        allow read, write: if isOwner(uid);
      }
    }
    
    // ── Books ─────────────────────────────────────────────────────
    match /books/{bookId} {
      // Anyone can read published books; author reads all (including drafts)
      allow read: if resource.data.visibility == 'published' || isAuthor();
      // Only author/admin can write
      allow write: if isAuthor();
      
      // ── Chapters ──────────────────────────────────────────────
      match /chapters/{chapterId} {
        // Anyone (guest or signed-in reader) can read published chapters in real-time
        // Drafts are strictly author-only
        allow read: if resource.data.status == 'published' || isAuthor();
        
        // Author can create chapters
        allow create: if isAuthor();

        // Author can update everything; signed-in readers can update likeCount
        allow update: if isAuthor() || (
          isSignedIn() && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
        );

        // Author chapter deletion permission:
        // Explicitly granted to author, admin, or chapter creator
        allow delete: if isAuthor() || (isSignedIn() && (
          (resource.data.authorId != null && resource.data.authorId == request.auth.uid) ||
          (resource.data.authorEmail != null && request.auth.token.email != null && resource.data.authorEmail.lower() == request.auth.token.email.lower())
        ));
        
        // ── Comments ────────────────────────────────────────────
        match /comments/{commentId} {
          // Anyone can read comments in real-time (including guest readers)
          allow read: if true;
          // Signed-in users create their own comments
          allow create: if isSignedIn() 
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 1000;
          // Users can delete their own; author can delete any
          allow delete: if isAuthor() 
            || (isSignedIn() && resource.data.userId == request.auth.uid);
          allow update: if false; // Comments are immutable
        }
      }
    }

    // ── Collection Group queries for Chapters ──
    match /{path=**}/chapters/{chapterId} {
      // Anyone can query published chapters across all books in real-time
      allow read: if resource.data.status == 'published' || isAuthor();
      allow delete: if isAuthor() || (isSignedIn() && (
        (resource.data.authorId != null && resource.data.authorId == request.auth.uid) ||
        (resource.data.authorEmail != null && request.auth.token.email != null && resource.data.authorEmail.lower() == request.auth.token.email.lower())
      ));
    }
    
    // ── Subscribers ───────────────────────────────────────────────
    match /subscribers/{id} {
      // Anyone can subscribe (create); only author can read
      allow create: if request.resource.data.email is string
        && validEmail(request.resource.data.email);
      allow read, update, delete: if isAuthor();
    }
  }
}
